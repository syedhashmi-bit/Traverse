WG_INTERFACE=wg0
WG_PORT=51820
WG_SUBNET=10.8.0.0/24
WG_SERVER_VPN_IP=10.8.0.1
WG_ENDPOINT=your-vps-ip-or-domain
WG_DNS=1.1.1.1
# Peer cap — default 20, hard ceiling 50 (clamped in code)
# MAX_PEERS=20
DATABASE_PATH=database.db
SECRET_KEY=changeme-use-a-strong-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-use-a-strong-password

# TOTP 2FA (optional) — generate with: python -c "import pyotp; print(pyotp.random_base32())"
# TOTP_SECRET=

# Telegram alerts (optional) — set both to enable
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# Pi-hole v6 (optional) — PIHOLE_URL is the direct FTL API base (no /pihole
# suffix; the app appends /api). PIHOLE_WEB_URL is the user-facing admin link.
# PIHOLE_ENABLED=1
# PIHOLE_URL=http://10.8.0.1:8080
# PIHOLE_PASSWORD=
# PIHOLE_WEB_URL=/pihole

# Peer inactivity alert threshold in hours (0 = disabled)
# ALERT_INACTIVE_HOURS=24

# ── Notifications (also editable via /notifications page) ───────────
# Email
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_SMTP_HOST=
NOTIFY_EMAIL_SMTP_PORT=587
NOTIFY_EMAIL_SMTP_USER=
NOTIFY_EMAIL_SMTP_PASS=

# Telegram
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# Discord
NOTIFY_DISCORD_WEBHOOK=

# Public stats (optional) — bearer token for GET /api/public-stats, a
# counts-only endpoint (peers_total / peers_online / traffic_30d_bytes) for an
# external status page. Unset or empty → the endpoint 404s. Generate with:
# openssl rand -hex 32
# TRAVERSE_PUBLIC_STATS_TOKEN=
